<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="soa_pdf_report">
        <t t-call="web.html_container">

            <style>
                .no-border-table {
                    border: 0 !important;
                    border-collapse: separate !important;
                    border-spacing: 0 !important;
                    outline: 0 !important;
                }

                .no-border-table tr,
                .no-border-table td,
                .no-border-table th,
                .no-border-table thead,
                .no-border-table tbody,
                .no-border-table tfoot {
                    border: 0 !important;
                    border-top: 0 !important;
                    border-bottom: 0 !important;
                    border-left: 0 !important;
                    border-right: 0 !important;
                    outline: 0 !important;
                }

                thead {
                    display: table-header-group;
                }

                tr {
                    page-break-inside: avoid;
                }
            </style>

            <!-- Running Header (Repeats on every page) -->
            <div class="header">
                <t t-if="data.get('company_report_header_image')">
                    <img t-att-src="'data:image/png;base64,%s' % data['company_report_header_image']"
                         style="
                            display: block;
                            width: 100%;
                            max-height: 90px;
                            object-fit: contain;
                            margin-bottom: 6px;
                         "/>
                </t>
                <t t-else="">
                    <table class="no-border-table"
                           border="0"
                           cellspacing="0"
                           cellpadding="0"
                           style="width: 100%; margin-bottom: 6px;">
                        <tr>
                            <td style="width: 25%; vertical-align: top; padding: 0;">
                                <t t-if="data.get('company_logo')">
                                    <img t-att-src="'data:image/png;base64,%s' % data['company_logo']"
                                         style="max-height: 60px; max-width: 140px;"/>
                                </t>
                            </td>
                            <td style="width: 75%; vertical-align: top; text-align: right; padding: 0; line-height: 1.35;">
                                <div style="font-weight: bold; font-size: 11.5px;"
                                     t-esc="data.get('company_name', '')"/>
                                <t t-if="data.get('company_zip')">
                                    <div>P.O.BOX: <span t-esc="data['company_zip']"/></div>
                                </t>
                                <div>
                                    <span t-esc="data.get('company_street', '')"/>
                                    <span t-if="data.get('company_city')">, <t t-esc="data['company_city']"/></span>
                                </div>
                                <t t-if="data.get('company_phone')">
                                    <div>Phone : <span t-esc="data['company_phone']"/></div>
                                </t>
                                <t t-if="data.get('company_email')">
                                    <div>Email : <span t-esc="data['company_email']"/></div>
                                </t>
                            </td>
                        </tr>
                    </table>
                </t>
            </div>

            <!-- Running Footer (Repeats on every page) -->
            <div class="footer"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 8.5px;
                    color: #333;
                    border: 0 !important;
                    border-top: 0 !important;
                    outline: 0 !important;
                    padding-top: 3px;
                 ">
                <t t-if="data.get('company_report_footer_image')">
                    <img t-att-src="'data:image/png;base64,%s' % data['company_report_footer_image']"
                         style="
                            width: 100%;
                            max-height: 85px;
                            object-fit: contain;
                            display: block;
                            margin-top: 3px;
                         "/>
                </t>
            </div>

            <!-- Main Document Content -->
            <div class="article"
                 style="
                    font-family: Arial, sans-serif;
                    font-size: 9.5px;
                    color: #000;
                 ">

                <div class="page">

                    <!-- Title -->
                    <div style="text-align: center; padding: 4px 0; margin-bottom: 8px;">
                        <h2 style="
                            font-size: 14px;
                            font-weight: bold;
                            margin: 0;
                            text-transform: uppercase;
                            color: #000;
                        ">
                            Statement of Accounts
                        </h2>
                    </div>

                    <!-- Customer & Date / Currency Details -->
                    <table class="no-border-table"
                           border="0"
                           cellspacing="0"
                           cellpadding="0"
                           style="
                                width: 100%;
                                margin-bottom: 8px;
                                font-size: 9.5px;
                           ">
                        <tr>
                            <!-- Customer Details (Left) -->
                            <td style="width: 58%; vertical-align: top; padding: 0; line-height: 1.35;">
                                <div style="font-weight: bold;">
                                    Customer :
                                    <t t-if="data.get('partner_ref')">
                                        <span t-esc="data['partner_ref']"/>
                                    </t>
                                    <span t-esc="data.get('partner_name', '')"/>
                                </div>

                                <t t-if="data.get('partner_zip')">
                                    <div>PO Box : <span t-esc="data['partner_zip']"/></div>
                                </t>

                                <div>
                                    Address :
                                    <span t-esc="data.get('partner_street', '')"/>
                                    <span t-if="data.get('partner_city')">, <t t-esc="data['partner_city']"/></span>
                                    <span t-if="data.get('partner_country')">, <t t-esc="data['partner_country']"/></span>
                                </div>

                                <t t-if="data.get('partner_email')">
                                    <div>E Mail : <span t-esc="data['partner_email']"/></div>
                                </t>
                            </td>

                            <!-- Date & Currency Details (Right) -->
                            <td style="width: 42%; vertical-align: top; padding: 0 0 0 10px; line-height: 1.5;">
                                <div>
                                    <strong>Date From&#160;&#160;:</strong>
                                    <span t-esc="data.get('date_from') or '01/01/2000'"/>
                                </div>

                                <div>
                                    <strong>Date To&#160;&#160;&#160;&#160;&#160;&#160;:</strong>
                                    <span t-esc="data.get('date_to', '')"/>
                                </div>

                                <div>
                                    <strong>Currency&#160;&#160;:</strong>
                                    <span t-esc="data.get('currency', '')"/>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Attention Line -->
                    <div style="font-weight: bold; margin-bottom: 6px; color: #000;">
                        ATTN. : ACCOUNTS DEPT.
                    </div>

                    <!-- SOA Ledger Table -->
                    <table border="0"
                           cellspacing="0"
                           cellpadding="0"
                           style="
                                width: 100%;
                                border-collapse: collapse;
                                border: none;
                                font-size: 9px;
                           ">
                        <thead>
                            <tr style="
                                border-top: 1px solid #000;
                                border-bottom: 1px solid #000;
                                text-align: left;
                            ">
                                <th style="padding: 4px 2px; width: 15%; border: none;">DATE</th>
                                <th style="padding: 4px 2px; width: 40%; border: none;">DOC. NO.</th>
                                <th style="padding: 4px 2px; width: 15%; border: none;">DUE DATE</th>
                                <th style="padding: 4px 2px; width: 10%; text-align: right; border: none;">DEBIT</th>
                                <th style="padding: 4px 2px; width: 10%; text-align: right; border: none;">CREDIT</th>
                                <th style="padding: 4px 2px; width: 10%; text-align: right; border: none;">BALANCE</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="data.get('lines', [])" t-as="l">
                                <tr style="border: none;">
                                    <td style="padding: 3px 2px; border: none;" t-esc="l.get('date', '')"/>
                                    <td style="padding: 3px 2px; border: none; word-break: break-word;" t-esc="l.get('doc_no', '')"/>
                                    <td style="padding: 3px 2px; border: none;" t-esc="l.get('due_date', '')"/>
                                    <td style="padding: 3px 2px; text-align: right; border: none;">
                                        <span t-esc="'{:,.2f}'.format(l['debit']) if l.get('debit') else '0.00'"/>
                                    </td>
                                    <td style="padding: 3px 2px; text-align: right; border: none;">
                                        <span t-esc="'{:,.2f}'.format(l['credit']) if l.get('credit') else '0.00'"/>
                                    </td>
                                    <td style="padding: 3px 2px; text-align: right; font-weight: bold; border: none;">
                                       <span t-esc="'{:,.2f}'.format(abs(l['balance'])) if l.get('balance') is not None else '0.00'"/>
                                    </td>
                                </tr>
                            </t>

                            <!-- Totals Row -->
                            <tr style="
                                font-weight: bold;
                                border-top: 1px solid #000;
                                border-bottom: 1px solid #000;
                            ">
                                <td colspan="3" style="padding: 4px 2px; text-align: right; border: none;">
                                    TOTAL:
                                </td>
                                <td style="padding: 4px 2px; text-align: right; border: none;">
                                    <span t-esc="'{:,.2f}'.format(data.get('total_debit', 0.0))"/>
                                </td>
                                <td style="padding: 4px 2px; text-align: right; border: none;">
                                    <span t-esc="'{:,.2f}'.format(data.get('total_credit', 0.0))"/>
                                </td>
                                <td style="padding: 4px 2px; text-align: right; border: none;">
                                    <span t-esc="'{:,.2f}'.format(abs(data.get('final_balance', 0.0)))"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                </div>

            </div>

        </t>
    </template>

</odoo>