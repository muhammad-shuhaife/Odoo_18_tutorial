<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_soa_report_wizard_form" model="ir.ui.view">
        <field name="name">soa.report.wizard.form</field>
        <field name="model">soa.report</field>
        <field name="arch" type="xml">
            <form string="Statement of Accounts">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="as_on_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_pdf" string="View / Print PDF" type="object" class="btn-primary"/>
                    <button name="action_generate_xlsx_report" string="Export Excel" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_soa_report_wizard" model="ir.actions.act_window">
        <field name="name">Statement of Accounts</field>
        <field name="res_model">soa.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>