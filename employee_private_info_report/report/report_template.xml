<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_private_info">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <style>
                            .pi-title { text-align:center; font-weight:bold; font-size:17px; margin:6px 0 4px 0; }
                            .pi-bar { background:#c00000; color:#fff; text-align:center; font-weight:bold;
                                      padding:2px 0; margin-top:20px; font-size:13px; text-transform:uppercase; }
                            table.pi { width:100%; border-collapse:collapse; table-layout:fixed; }
                            table.pi td { padding:8px 4px 0 4px; vertical-align:bottom; font-size:12px; color:#222; }
                            td.l { width:20%; }
                            td.v { border-bottom:1px solid #555; height:22px; }
                            td.gap { width:2%; }
                            td.cap { font-size:9px; font-style:italic; color:#333; padding-top:1px; }
                            tr { page-break-inside:avoid; }
                        </style>

                        <div class="pi-title">Employee Private Information Form</div>

                        <!-- PRIVATE CONTACT -->
                        <div class="pi-bar">Private Contact</div>
                        <table class="pi">
                            <tr>
                                <td class="l">Full Name:</td>
                                <td class="v" colspan="3"><t t-out="o.name"/></td>
                            </tr>
                        </table>
                        <table class="pi">
                            <tr>
                                <td class="l">Private Address:</td>
                                <td class="v" style="width:48%;"><t t-out="o._pv('private_street')"/></td>
                                <td class="gap"></td>
                                <td class="v" style="width:30%;"><t t-out="o._pv('private_street2')"/></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td class="cap">Street</td><td></td>
                                <td class="cap">Street 2</td>
                            </tr>
                        </table>
                        <table class="pi">
                            <tr>
                                <td class="l"></td>
                                <td class="v" style="width:33%;"><t t-out="o._pv('private_city')"/></td>
                                <td class="gap"></td>
                                <td class="v" style="width:25%;"><t t-out="o._pv('private_state_id')"/></td>
                                <td class="gap"></td>
                                <td class="v" style="width:18%;"><t t-out="o._pv('private_zip')"/></td>
                            </tr>
                            <tr>
                                <td></td>
                                <td class="cap">City</td><td></td>
                                <td class="cap">State</td><td></td>
                                <td class="cap">ZIP</td>
                            </tr>
                        </table>
                        <table class="pi">
                            <tr>
                                <td class="l">Private Country:</td><td class="v" style="width:30%;"><t t-out="o._pv('private_country_id')"/></td>
                                <td class="l">Private Phone:</td><td class="v" style="width:30%;"><t t-out="o._pv('private_phone')"/></td>
                            </tr>
                            <tr>
                                <td class="l">Private Email:</td><td class="v"><t t-out="o._pv('private_email')"/></td>
                                <td class="l">Bank Account:</td><td class="v"><t t-out="o._pv('bank_account_id')"/></td>
                            </tr>
                            <tr>
                                <td class="l">Home-Work Distance:</td><td class="v"><t t-out="o._pv('distance_home_work', 'km_home_work')"/></td>
                                <td class="l">Private Car Plate:</td><td class="v"><t t-out="o._pv('private_car_plate')"/></td>
                            </tr>
                        </table>

                        <!-- CITIZENSHIP -->
                        <div class="pi-bar">Citizenship</div>
                        <table class="pi">
                            <tr>
                                <td class="l">Nationality (Country):</td><td class="v" style="width:30%;"><t t-out="o._pv('country_id')"/></td>
                                <td class="l">Identification No:</td><td class="v" style="width:30%;"><t t-out="o._pv('identification_id')"/></td>
                            </tr>
                            <tr>
                                <td class="l">SSN No:</td><td class="v"><t t-out="o._pv('ssnid')"/></td>
                                <td class="l">Passport No:</td><td class="v"><t t-out="o._pv('passport_id')"/></td>
                            </tr>
                            <tr>
                                <td class="l">Gender:</td><td class="v"><t t-out="o._pv('gender', 'sex')"/></td>
                                <td class="l">Date of Birth:</td><td class="v"><t t-out="o._pv('birthday')"/></td>
                            </tr>
                            <tr>
                                <td class="l">Place of Birth:</td><td class="v"><t t-out="o._pv('place_of_birth')"/></td>
                                <td class="l">Country of Birth:</td><td class="v"><t t-out="o._pv('country_of_birth')"/></td>
                            </tr>
                        </table>

                        <!-- FAMILY STATUS -->
                        <div class="pi-bar">Family Status</div>
                        <table class="pi">
                            <tr>
                                <td class="l">Marital Status:</td><td class="v" style="width:30%;"><t t-out="o._pv('marital')"/></td>
                                <td class="l">Number of Dependent Children:</td><td class="v" style="width:30%;"><t t-out="o._pv('children')"/></td>
                            </tr>
                            <tr>
                                <td class="l">Spouse Complete Name:</td><td class="v"><t t-out="o._pv('spouse_complete_name')"/></td>
                                <td class="l">Spouse Birthdate:</td><td class="v"><t t-out="o._pv('spouse_birthdate')"/></td>
                            </tr>
                        </table>

                        <!-- EMERGENCY -->
                        <div class="pi-bar">Emergency</div>
                        <table class="pi">
                            <tr>
                                <td class="l">Contact Name:</td><td class="v" style="width:30%;"><t t-out="o._pv('emergency_contact')"/></td>
                                <td class="l">Contact Phone:</td><td class="v" style="width:30%;"><t t-out="o._pv('emergency_phone')"/></td>
                            </tr>
                        </table>

                        <!-- EDUCATION -->
                        <div class="pi-bar">Education</div>
                        <table class="pi">
                            <tr>
                                <td class="l">Certificate Level:</td><td class="v" colspan="3"><t t-out="o._pv('certificate')"/></td>
                            </tr>
                            <tr>
                                <td class="l">Field of Study:</td><td class="v" colspan="3"><t t-out="o._pv('study_field')"/></td>
                            </tr>
                            <tr>
                                <td class="l">School:</td>
                                <td class="v" colspan="3"><t t-out="o._pv('study_school')"/></td>
                            </tr>
                        </table>

                        <!-- WORK PERMIT -->
                        <div class="pi-bar">Work Permit</div>
                        <table class="pi">
                            <tr>
                                <td class="l">Visa No:</td><td class="v" style="width:30%;"><t t-out="o._pv('visa_no')"/></td>
                                <td class="l">Work Permit No:</td><td class="v" style="width:30%;"><t t-out="o._pv('permit_no')"/></td>
                            </tr>
                            <tr>
                                <td class="l">Visa Expiration Date:</td><td class="v"><t t-out="o._pv('visa_expire')"/></td>
                                <td class="l">Work Permit Expiration Date:</td><td class="v"><t t-out="o._pv('work_permit_expiration_date')"/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
