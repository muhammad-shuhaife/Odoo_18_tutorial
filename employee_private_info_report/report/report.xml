<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_employee_private_info" model="ir.actions.report">
        <field name="name">Employee Private Information</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">employee_private_info_report.report_private_info</field>
        <field name="report_file">employee_private_info_report.report_private_info</field>
        <field name="print_report_name">"Private Information - %s" % (object.name or "Blank Form")</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <!-- Blank form: no employee record needed -->
    <menuitem id="menu_blank_private_info_form"
              name="Blank Private Form"
              parent="hr.menu_hr_root"
              action="action_report_employee_private_info"
              sequence="90"
              groups="hr.group_hr_user"/>
</odoo>
