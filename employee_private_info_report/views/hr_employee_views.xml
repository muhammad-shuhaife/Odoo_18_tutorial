<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_print_private_info" model="ir.ui.view">
        <field name="name">hr.employee.form.print.private.info</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Employee has a name (saved or typed): normal print, saves first -->
                <button name="action_print_private_information" type="object"
                        string="Print Private Information"
                        class="btn-secondary"
                        invisible="not id and not name"
                        groups="hr.group_hr_user"/>
                <!-- No name and not saved: open the blank form directly (no save) -->
                <a class="btn btn-secondary o_pi_blank_link"
                   href="/employee_private_info/blank"
                   target="_blank"
                   invisible="id or name"
                   groups="hr.group_hr_user">Print Private Information</a>
            </xpath>
        </field>
    </record>
</odoo>
