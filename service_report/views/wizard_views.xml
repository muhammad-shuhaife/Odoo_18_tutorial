<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View: Only From and To Date visible -->
    <record id="view_service_report_wizard_form" model="ir.ui.view">
        <field name="name">service.report.wizard.form</field>
        <field name="model">service.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Service Report">
                <field name="report_type" invisible="1"/>
                <group>
                    <group>
                        <field name="date_from"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Print Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Sales Reporting -->
    <record id="action_service_report_wizard_sale" model="ir.actions.act_window">
        <field name="name">Sales Analysis by Product</field>
        <field name="res_model">service.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'sale'}</field>
    </record>

    <!-- Action for Purchase Reporting -->
    <record id="action_service_report_wizard_purchase" model="ir.actions.act_window">
        <field name="name">Purchase Analysis by Product</field>
        <field name="res_model">service.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'purchase'}</field>
    </record>

    <!-- Sales -> Reporting -> Service Report -->
    <menuitem id="menu_service_report_sale"
              name="Sales Analysis by Product"
              action="action_service_report_wizard_sale"
              parent="sale.menu_sale_report"
              sequence="40"/>

    <!-- Purchase -> Reporting -> Service Report -->
    <menuitem id="menu_service_report_purchase"
              name="Purchase Analysis by Product"
              action="action_service_report_wizard_purchase"
              parent="purchase.purchase_report_main"
              sequence="40"/>
</odoo>