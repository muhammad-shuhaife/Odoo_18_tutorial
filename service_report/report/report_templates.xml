<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_service_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center mb-3">
                            <span t-if="wizard.report_type == 'sale'">Sales</span>
                            <span t-else="">Purchase</span>
                            Service Report
                        </h2>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>From:</strong> <span t-field="wizard.date_from"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>To:</strong> <span t-field="wizard.date_to"/>
                            </div>
                        </div>

                        <t t-set="groups" t-value="get_data(wizard)"/>

                        <t t-if="not groups">
                            <p class="text-muted text-center mt-5">No service records found for this period.</p>
                        </t>

                        <t t-foreach="groups" t-as="group">
                            <h4 class="mt-4 mb-2"><span t-esc="group['name']"/></h4>
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date</th>
                                        <th>Service</th>
                                        <th class="text-end">Qty</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="group['lines']" t-as="line">
                                        <tr>
                                            <td><span t-esc="line['date']"/></td>
                                            <td><span t-esc="line['service']"/></td>
                                            <td class="text-end"><span t-esc="line['qty']"/></td>
                                            <td class="text-end">
                                                <span t-esc="line['amount']"
                                                      t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <tr class="table-secondary fw-bold">
                                        <td colspan="2" class="text-end">Monthly Total</td>
                                        <td class="text-end"><span t-esc="group['qty']"/></td>
                                        <td class="text-end">
                                            <span t-esc="group['amount']"
                                                  t-options="{'widget': 'monetary', 'display_currency': wizard.company_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>