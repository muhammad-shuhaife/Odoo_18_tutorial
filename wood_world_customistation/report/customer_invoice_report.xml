<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reuses the same paperformat as the Quotation / PO / Proforma Invoice reports -->

    <record id="action_report_account_move_full" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wood_world_customistation.report_account_move_full_document</field>
        <field name="report_file">wood_world_customistation.report_account_move_full_document</field>
        <field name="print_report_name">'INVOICE - %s' % (object.name)</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="paperformat_id" ref="wood_world_customistation.paperformat_proforma_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ============================================================ -->
    <!-- Uses the shared wood_world_customistation.report_header_footer_wwd  -->
    <!-- template (defined in the Proforma Invoice report) so the same -->
    <!-- in-flow banner header/footer image is used here too, instead  -->
    <!-- of the old logo/company-block header and the wkhtmltopdf      -->
    <!-- footer frame.                                                  -->
    <!--                                                                -->
    <!-- NOTE: the old footer's live "Page X / Y" counter (<span        -->
    <!-- class="page"/> / <span class="topage"/>) only works inside a  -->
    <!-- true wkhtmltopdf footer frame. Since the banner + footer are  -->
    <!-- now rendered as ordinary in-flow content (t-out="0"), that    -->
    <!-- counter can no longer be shown — same trade-off already noted -->
    <!-- in the Proforma Invoice report.                                -->
    <!-- ============================================================ -->
    <template id="report_account_move_full_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="wood_world_customistation.report_header_footer_wwd">

                    <style>
                        .page { padding: 20px !important; margin: 0 !important; font-size: 12px; }
                        .inv-table {
                        width: 100%;
                        border-collapse: collapse;
                        font-size: 10.5px;
                        margin-top: 0;
                        table-layout: fixed;
                        }
                        .inv-table th, .inv-table td {
                        border: 1px solid #000;
                        padding: 5px 4px;
                        vertical-align: middle;
                        word-wrap: break-word;
                        }
                        .inv-table th {
                        background-color: #f2f2f2;
                        text-align: center;
                        font-weight: bold;
                        font-size: 9.5px;
                        }
                        .bottom-info {
                        position: fixed;
                        bottom: 130px;
                        left: 20px;
                        right: 20px;
                        z-index: 10;
                        }
                        .inv-table .text-end { text-align: right; }
                        .inv-table .text-center { text-align: center; }
                        .inv-table .section-row td { background-color: #eef2f7; font-weight: bold; }
                        .inv-table .note-row td { font-style: italic; color: #555; border-top: none; }
                        .label-blue { color: #3D6FB4; font-weight: bold; }
                        .totals-box { width: 260px; border-collapse: collapse; font-size: 12px; margin-top: 10px; }
                        .totals-box td { border: 1px solid #000; padding: 6px 10px; }
                        .totals-box .total-row,
                        .totals-box .total-row td {
                        background-color: #f2f2f2 !important;
                        color: #000 !important;
                        font-weight: bold;
                        }
                        .amount-words { font-size: 11px; margin-top: 8px; text-align: right; color: #3D6FB4;
                        word-wrap: break-word; }
                        .sign-line { border-top: 1px dotted #000; padding-top: 4px; font-size: 11px; font-weight: bold;
                        }
                        .terms-box { font-size: 11px; margin-top: 15px; }
                    </style>

                    <div class="page">

                        <!-- 1. Title -->
                        <div style="text-align:center;margin:10px 0 20px 0;">
                            <h2 style="margin:0;text-decoration:underline;font-weight:bold;">TAX INVOICE</h2>
                        </div>

                        <!-- 2. Bill To / Invoice Info -->
                        <table style="width:100%;margin-bottom:15px;">
                            <tr>
                                <td style="width:55%;vertical-align:top;">
                                    <div>Bill To:</div>
                                    <div t-field="doc.partner_id.name"/>
                                    <div t-field="doc.partner_id.street"/>
                                    <div t-field="doc.partner_id.city"/>
                                    <div t-field="doc.partner_id.state_id.name"/>
                                    <div t-field="doc.partner_id.country_id.name"/>
                                    <t t-if="doc.partner_id.vat">
                                        <div>VAT:
                                            <span t-field="doc.partner_id.vat"/>
                                        </div>
                                    </t>
                                </td>
                                <td style="width:45%;vertical-align:top;text-align:right;">
                                    <div>
                                        VAT:
                                        <span t-field="doc.company_id.vat"/>
                                    </div>
                                    <div t-if="doc.name">
                                        <span>Invoice No :</span>
                                        <span t-field="doc.name"/>
                                    </div>
                                    <div>
                                        Invoice Date :
                                        <span t-field="doc.invoice_date"/>
                                    </div>
                                    <t t-if="doc.invoice_date_due">
                                        <div>
                                            Due Date :
                                            <span t-field="doc.invoice_date_due"/>
                                        </div>
                                    </t>
                                    <t t-if="doc.invoice_payment_term_id">
                                        <div>
                                            Payment Terms :
                                            <span t-field="doc.invoice_payment_term_id.name"/>
                                        </div>
                                    </t>
                                    <div>
                                        Salesperson :
                                        <span t-field="doc.invoice_user_id.name"/>
                                    </div>
                                    <div t-if="doc.project_id">
                                        Project :
                                        <span t-field="doc.project_id"/>
                                    </div>
                                    <div t-if="doc.subject">
                                        Subject :
                                        <span t-field="doc.subject"/>
                                    </div>
                                    <div t-if="doc.reference">
                                        Reference :
                                        <span t-field="doc.reference"/>
                                    </div>
                                    <div t-if="doc.job_reference">
                                        Job Reference :
                                        <span t-field="doc.job_reference"/>
                                    </div>
                                    <div t-if="doc.lpo_ref">
                                        LPO :
                                        <span t-field="doc.lpo_ref"/>
                                    </div>

                                </td>
                            </tr>
                        </table>

                        <!-- 4. Itemized Invoice Lines -->
                        <table class="inv-table">
                            <thead>
                                <tr>
                                    <th style="width: 4%;">S.NO</th>
                                    <th style="width: 26%;">Description</th>
                                    <th style="width: 7%;">Qty</th>
                                    <th style="width: 10%;">Rate</th>
                                    <th style="width: 10%;">Amount</th>
                                    <th style="width: 12%;">Taxable Amt</th>
                                    <th style="width: 6%;">VAT %</th>
                                    <th style="width: 12%;">VAT Amount</th>
                                    <th style="width: 13%;">Total Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_no" t-value="0"/>
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <!--
                                        FIX (Odoo 18): normal product/service lines now have
                                        display_type == 'product' instead of False/falsy.
                                        The old "not line.display_type" check silently excluded
                                        every real line, leaving only section/note rows.
                                    -->
                                    <t t-if="line.display_type == 'product'">
                                        <t t-set="line_no" t-value="line_no + 1"/>

                                        <!-- Per-line calculations -->
                                        <t t-set="line_amount" t-value="line.price_subtotal"/>
                                        <t t-set="line_taxable_amount" t-value="line.price_subtotal"/>
                                        <t t-set="line_vat_amount" t-value="line.price_total - line.price_subtotal"/>
                                        <t t-set="line_total_amount" t-value="line.price_total"/>
                                        <t t-set="line_vat_percent"
                                           t-value="line.tax_ids[0].amount if line.tax_ids else 0.0"/>

                                        <tr>
                                            <td class="text-center">
                                                <span t-esc="line_no"/>
                                            </td>
                                            <td>
                                                <span t-field="line.name"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-field="line.quantity"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="'{:,.{p}f}'.format(line.price_unit, p=doc.currency_id.decimal_places)"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="'{:,.{p}f}'.format(line_amount, p=doc.currency_id.decimal_places)"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="'{:,.{p}f}'.format(line_taxable_amount, p=doc.currency_id.decimal_places)"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="('{:.0f}'.format(line_vat_percent) if line_vat_percent == int(line_vat_percent) else '{:.2f}'.format(line_vat_percent)) + '%'"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="'{:,.{p}f}'.format(line_vat_amount, p=doc.currency_id.decimal_places)"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="'{:,.{p}f}'.format(line_total_amount, p=doc.currency_id.decimal_places)"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_section'">
                                        <tr class="section-row">
                                            <td colspan="9">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr class="note-row">
                                            <td colspan="9">
                                                <span t-field="line.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <!-- 5. Totals Box -->
                        <table style="width:100%;">
                            <tr>
                                <td style="width:60%;"></td>
                                <td style="width:40%;">
                                    <table class="totals-box" style="margin-left:auto;">
                                        <tr>
                                            <td>Untaxed Amount</td>
                                            <td class="text-end">
                                                <t t-if="doc.currency_id.position == 'after'">
                                                    <span t-esc="'%s %s' % ('{:,.{p}f}'.format(doc.amount_untaxed, p=doc.currency_id.decimal_places), doc.currency_id.symbol)"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="'%s %s' % (doc.currency_id.symbol, '{:,.{p}f}'.format(doc.amount_untaxed, p=doc.currency_id.decimal_places))"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Taxes</td>
                                            <td class="text-end">
                                                <t t-if="doc.currency_id.position == 'after'">
                                                    <span t-esc="'%s %s' % ('{:,.{p}f}'.format(doc.amount_tax, p=doc.currency_id.decimal_places), doc.currency_id.symbol)"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="'%s %s' % (doc.currency_id.symbol, '{:,.{p}f}'.format(doc.amount_tax, p=doc.currency_id.decimal_places))"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="total-row">
                                            <td>Total</td>
                                            <td class="text-end">
                                                <t t-if="doc.currency_id.position == 'after'">
                                                    <span t-esc="'%s %s' % ('{:,.{p}f}'.format(doc.amount_total, p=doc.currency_id.decimal_places), doc.currency_id.symbol)"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-esc="'%s %s' % (doc.currency_id.symbol, '{:,.{p}f}'.format(doc.amount_total, p=doc.currency_id.decimal_places))"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <t t-if="doc.amount_residual != 0">
                                            <tr>
                                                <td>Amount Due</td>
                                                <td class="text-end">
                                                    <t t-if="doc.currency_id.position == 'after'">
                                                        <span t-esc="'%s %s' % ('{:,.{p}f}'.format(doc.amount_residual, p=doc.currency_id.decimal_places), doc.currency_id.symbol)"/>
                                                    </t>
                                                    <t t-else="">
                                                        <span t-esc="'%s %s' % (doc.currency_id.symbol, '{:,.{p}f}'.format(doc.amount_residual, p=doc.currency_id.decimal_places))"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </td>
                            </tr>
                        </table>

                        <!-- 6. Terms &amp; Conditions -->
                        <t t-if="doc.company_id.invoice_report_description">
                            <div class="terms-box">
                                <span t-field="doc.company_id.invoice_report_description"/>
                            </div>
                        </t>

                        <!-- 7. Signature Blocks -->
                        <div class="bottom-info">

                            <table style="width:100%;margin-top:60px;">
                                <tr>
                                    <td style="width:50%;">
                                        <div style="height:16px;"></div>
                                    </td>
                                    <td style="width:50%;text-align:right;">
                                        <div style="font-weight:bold;font-size:11px;">
                                            <span t-field="doc.company_id.name"/>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width:50%;">
                                        <div class="sign-line">Customer Signature &amp; Stamp</div>
                                    </td>
                                    <td style="width:50%;text-align:right;">
                                        <div class="sign-line" style="text-align:right;">Authorised Signatory</div>
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </div>

                </t>
            </t>
        </t>
    </template>
</odoo>