<odoo>

    <record id="view_purchase_order_form_inherit_wwd" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.wwd</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="delivery_term_id"/>
                <field name="delivery_details"/>
                <field name="reference"/>
                <field name="job_reference"/>
            </xpath>
            <xpath expr="//field[@name='notes']" position="before">
                <label for="notes" string="Notes"/>
            </xpath>
            <xpath expr="//field[@name='notes']" position="after">
                <field name="remarks"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <xpath expr="//field[@name='payment_term_id']" position="move"/>
                <xpath expr="//field[@name='project_id']" position="move"/>
                <field name="subject"/>


            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_project_ref" model="ir.ui.view">
        <field name="name">purchase.order.form.project.ref</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_qty']" position="before">
                <field name="product_job_reference"
                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>