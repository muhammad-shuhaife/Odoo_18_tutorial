<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_wwd" model="ir.ui.view">
        <field name="name">res.company.form.inherit.wwd</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="after">
                <page name="report_terms" string="Report Terms">

                    <separator string="Report Terms"/>

                    <label for="quotation_report_description" string="Quotation Terms"/>
                    <field name="quotation_report_description"
                           widget="html"
                           options="{'style-inline': true}"
                           placeholder="Enter Quotation description..."
                           nolabel="1"
                           colspan="2"/>

                    <label for="pi_report_description" string="Proforma Invoice Terms"/>
                    <field name="pi_report_description"
                           widget="html"
                           options="{'style-inline': true}"
                           placeholder="Enter Proforma Invoice description..."
                           nolabel="1"
                           colspan="2"/>

                    <label for="po_report_description" string="Purchase Order Terms"/>
                    <field name="po_report_description"
                           widget="html"
                           options="{'style-inline': true}"
                           placeholder="Enter PO description..."
                           nolabel="1"
                           colspan="2"/>

                    <label for="invoice_report_description" string="Invoice Terms"/>
                    <field name="invoice_report_description"
                           widget="html"
                           options="{'style-inline': true}"
                           placeholder="Enter Invoice description..."
                           nolabel="1"
                           colspan="2"/>

                    <separator string="Report Images"/>

                    <group col="2">
                        <field name="report_header_image" widget="image"/>
                        <field name="report_footer_image" widget="image"/>
                    </group>

                </page>
            </xpath>
        </field>
    </record>
</odoo>