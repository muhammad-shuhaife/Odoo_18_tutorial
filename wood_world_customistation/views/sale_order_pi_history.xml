<odoo>
    <record id="view_sale_order_pi_history_list" model="ir.ui.view">
        <field name="name">sale.order.pi.history.list</field>
        <field name="model">sale.order.pi.history</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="name"/>
                <field name="create_date" string="Generated On"/>
                <field name="user_id"/>
                <field name="payment_percentage"/>
                <field name="full_amount"/>
                <field name="amount"/>
                <field name="qty"/>
            </list>
        </field>
    </record>

    <record id="view_sale_order_pi_history_form" model="ir.ui.view">
        <field name="name">sale.order.pi.history.form</field>
        <field name="model">sale.order.pi.history</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" string="Proforma Invoice">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1"/>
                        </h1>
                        <h3>
                            <field name="sale_order_id" nolabel="1" options="{'no_open': False}"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Generated By">
                            <field name="user_id"/>
                            <field name="create_date" string="Date"/>
                        </group>
                        <group string="Payment Details">
                            <field name="payment_percentage"/>
                            <field name="full_amount"/>
                            <field name="amount" string="Amount Printed"/>
                            <field name="qty" string="Qty Printed"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="summary" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>